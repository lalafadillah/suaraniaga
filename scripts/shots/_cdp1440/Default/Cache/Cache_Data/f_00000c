                    <div class="flex flex-wrap items-center gap-4" @voice-transcript="query = $event.detail.value"
     x-data="{
        recording: false,
        start() {
            this.recording = true;
            $store.suara.start((value) => {
                this.recording = false;
                this.$dispatch('voice-transcript', { value });
            });
        },        stop() {
            this.recording = false;
            $store.suara.stop();
        },
     }">

    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] font-semibold transition-colors disabled:cursor-not-allowed disabled:opacity-60 border border-line bg-surface text-ink hover:bg-brand-soft h-[54px] px-6 text-base" x-bind:class="recording ? '!border-brand !bg-brand-soft' : ''" x-on:click="recording ? stop() : start()" x-bind:aria-pressed="recording"><span x-show="!recording">Mulai pencarian suara</span>
