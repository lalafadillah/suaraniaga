                    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] font-semibold transition-colors disabled:cursor-not-allowed disabled:opacity-60 border border-brand bg-surface text-brand hover:bg-brand-soft h-[54px] px-6 text-base" x-on:click="$store.suara.start((value) => setStepValue(value))">Ulangi rekaman</button>

                    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] font-semibold transition-colors disabled:cursor-not-allowed disabled:opacity-60 bg-brand text-white hover:bg-brand/90 h-[54px] px-6 text-base" x-on:click="next()"><span x-show="langkah < total">Lanjut ke <span x-text="labels[['nama','harga','stok','deskripsi'][langkah]]"></span></span>
